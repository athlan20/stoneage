{"meta": {"desc": "握手字段不对：回复 BAD_REQUEST，连接保持，之后仍可正常握手", "stage": "STAGE-2"}}
{"conn": "player", "dir": "c2s", "msg": {"id": 1, "type": "hello", "data": {}}}
{"conn": "player", "dir": "s2c", "msg": {"id": 1, "type": "hello", "ok": false, "error": {"code": "BAD_REQUEST", "message": "*=缺少 protocol"}}}
{"conn": "player", "dir": "c2s", "msg": {"id": 2, "type": "hello", "data": {"protocol": "1"}}}
{"conn": "player", "dir": "s2c", "msg": {"id": 2, "type": "hello", "ok": false, "error": {"code": "BAD_REQUEST", "message": "*=请求的 data 字段不正确"}}}
{"conn": "player", "dir": "c2s", "msg": {"id": 3, "type": "hello", "data": {"protocol": 1, "role": "robot"}}}
{"conn": "player", "dir": "s2c", "msg": {"id": 3, "type": "hello", "ok": false, "error": {"code": "BAD_REQUEST", "message": "*=role 只能是 player 或 agent"}}}
{"conn": "player", "dir": "c2s", "msg": {"id": 4, "type": "hello", "data": {"protocol": 1, "client": "*", "role": "player"}}}
{"conn": "player", "dir": "s2c", "msg": {"id": 4, "type": "hello", "ok": true, "data": {"protocol": 1, "server": "*=stoneage-mock/0.1.0", "heartbeat_seconds": "*=20", "idle_timeout_seconds": "*=60", "register_enabled": true}}}
